<div class="govuk-body ncce-csa-dash__section ncce-csa-dash__section-padded">
  <% if @user_programme_assessment.currently_taking_test? %>
    <%= render 'certificates/assessment_attempt_status', attempt: @user_programme_assessment.latest_attempt %>
  <% elsif @user_programme_assessment.in_cool_off? %>
    <%= render layout: 'certificates/assessment_info' do %>
      <p class="govuk-body">
        You've taken the test <%= attempt_count_in_words(failed_num_attempts) %> without passing. You can take it again after <strong><%= retry_at %></strong>.
      </p>
    <% end %>
    <%= cool_off_advice %>
  <% else %>
    <%= render 'certificates/assessment_attempt_status', attempt: @user_programme_assessment.latest_attempt %>
    <p class="govuk-body">
      Ready to take your test?
    </p>
    <% if failed_num_attempts == 1 %>
      <%= render layout: 'certificates/assessment_info' do %>
        <p class="govuk-body">
          You've taken the test once without passing. You can take it again straight away. If you don't pass, you'll need to wait <%= cool_off_hours %> hours before trying again.
        </p>
      <% end %>
    <% elsif failed_num_attempts > 1 %>
      <%= render layout: 'certificates/assessment_info' do %>
        <p class="govuk-body">
          You've taken the test <%= attempt_count_in_words(failed_num_attempts) %> without passing. If you don't pass your next attempt, you'll need to wait <%= cool_off_hours %> hours before trying again.
        </p>
      <% end %>
    <% end %>
    <div class="ncce-csa-dash__sub-section govuk-!-margin-bottom-5">
      <ul class='govuk-list govuk-list--bullet govuk-body-s'>
        <li>You'll have <%= @duration %> minutes to answer <%= @question_count %> multiple-choice questions and you must complete the test in one sitting.</li>
        <li>Your test attempt will begin as soon as you click 'Take the test' below.</li>
        <li>The test must be taken under exam conditions (i.e: no notes or text books, in isolation without communicating with others, no other open tabs on any internet enabled device(s), and all answers must be your own). See <%= link_to 'full details of exam conditions', @conditions_url, class: 'ncce-link', data: helpers.tracking_data('Exam conditions doc') %>.</li>
        <li>If you have a disability, impairment or sensory loss, or an additional need such as a dyslexia or a requirement for assistive technology to enable you to complete the test, we can extend the test time to <%= @extended_duration %> minutes. To request this, please <%= mail_to 'certificationqueries@bcs.uk', 'email us', class: 'ncce-link' %> and we'd be happy to help.</li>
        <% if @leader_confirmation %>
          <li>Once you start the test, you'll be required to provide the email address of a Senior Leader or course leader in your school who can confirm you have completed the test under exam conditions.</li>
        <% end %>
        <li>The pass mark is 65%. You can take the test twice straight away. After that, you'll need to wait <%= cool_off_hours %> hours after a failed attempt before trying again.</li>
        <li>When you've finished the test on ClassMarker, use the button at the end to come back here and see your result.</li>
      </ul>
    </div>

    <%= form_for(@user, method: :post, url: assessment_attempts_path) do |f| %>
      <p class="govuk-body-s govuk-!-margin-bottom-2">
        <strong>Teacher reference number (TRN)</strong> <%= link_to "what's this?", 'https://www.gov.uk/guidance/individual-teacher-records-information-for-teachers#your-teacher-reference-number-trn', class: 'govuk-body-s ncce-link ', target: '_blank' %>
      </p>
      <p class="govuk-body-s govuk-!-margin-bottom-5">
        <%= f.text_field :teacher_reference_number,
            class: 'govuk-input ncce-input ncce-csa-dash__trn',
            'aria-label': 'Enter your teacher reference number',
            placeholder: 'optional',
            value: @user.teacher_reference_number
        %>
      </p>

      <div data-controller="toggle-attribute" data-toggle-attribute-name-value="disabled" data-toggle-attribute-value-value="true">
        <%= fields_for :assessment_attempt do |sf| %>
          <div class="govuk-checkboxes__item ncce-checkboxes__item ncce-checkboxes__item--multiline <%= 'govuk-!-margin-bottom-5' unless @leader_confirmation %>">
            <%= sf.check_box :accepted_conditions, {
              class: 'govuk-checkboxes__input ncce-checkboxes__input',
              data: {
                'aria-label': 'Accept our exam conditions',
                action: 'change->toggle-attribute#toggleAttribute',
                'toggle-attribute-target' => 'source'
              }
            }, '1', '0' %>
            <%= sf.label :accepted_conditions, class: 'govuk-checkboxes__label ncce-label ncce-checkboxes__label ncce-checkboxes__label--multiline' do %>
              I have read and accept <%= link_to 'the full exam conditions', @conditions_url, class: 'ncce-link', data: helpers.tracking_data('Exam conditions doc') %>.
            <% end %>
          </div>
          <% if @leader_confirmation %>
            <div class='govuk-checkboxes__item ncce-checkboxes__item ncce-checkboxes__item--multiline govuk-!-margin-bottom-5'>
              <%= check_box_tag 'ready_to_test', '1', false, {
                class: 'govuk-checkboxes__input ncce-checkboxes__input',
                data: {
                  'aria-label': 'Ready to take the test',
                  action: 'change->toggle-attribute#toggleAttribute',
                  'toggle-attribute-target' => 'ready'
                }
              } %>
              <%= label_tag 'ready_to_test', 'I am ready to begin the test under exam conditions and I have details to hand of a leader in my school who can confirm this.',
                class: 'govuk-checkboxes__label ncce-label ncce-checkboxes__label ncce-checkboxes__label--multiline' %>
            </div>
          <% end %>

          <%= sf.hidden_field 'user_id', value: @user.id %>
          <%= sf.hidden_field 'assessment_id', value: @assessment.id %>
        <% end %>
        <%= f.submit 'Take the test', class: 'govuk-button button govuk-!-margin-bottom-0', disabled: true, data: { 'toggle-attribute-target' => 'button' } %>
      </div>
    <% end %>
  <% end %>
</div>
