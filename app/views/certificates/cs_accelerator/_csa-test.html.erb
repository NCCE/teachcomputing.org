<div class="govuk-body ncce-csa-dash__section ncce-csa-dash__section-padded" id="csa-test">
  <p class="govuk-body govuk-!-margin-0">
    Want to practice for the test?
    <%= link_to 'Take our mock test', 'https://www.classmarker.com/online-test/start/?quiz=gq36013dee29b07b', class: 'ncce-link', data: tracking_data('Take mock test') %>
  </p>
</div>

<div class="govuk-body ncce-csa-dash__section ncce-csa-dash__section-padded">
  <% if user_programme_assessment.currently_taking_test? %>
    <%= render 'certificates/assessment_attempt_status', attempt: user_programme_assessment.latest_attempt %>
  <% elsif user_programme_assessment.can_take_test_at != 0 %>
    <%= render layout: 'certificates/assessment_info' do %>
      <p class="govuk-body">
        You've taken the test <%= attempt_count_in_words(user_programme_assessment.failed_num_attempts) %> without passing. You can take it again after <strong><%= assessment_time(Time.zone.now + user_programme_assessment.can_take_test_at.seconds) %></strong>.
      </p>
    <% end %>
    <p class="govuk-body govuk-!-margin-0">
      You may want to consider completing additional courses before your next attempt. You can find full details of areas for improvement in your results email, and course recommendations in the <%= link_to 'KS3 and GCSE subject knowledge handbook', 'https://ncce.io/csa-handbook', class: 'ncce-link', data: tracking_data('CSA Handbook') %>.
    </p>
  <% else %>
    <%= render 'certificates/assessment_attempt_status', attempt: user_programme_assessment.latest_attempt %>
    <%= render AssessmentDetailsComponent.new(
      user: current_user,
      assessment: @programme.assessment,
      duration: 30,
      question_count: 25,
      extended_duration: 45,
      conditions_url: 'https://static.teachcomputing.org/CSA-Exam-Conditions.pdf',
      confirm_ready: true
    ) do |component| %>
      <% if user_programme_assessment.failed_num_attempts == 1 %>
        <% component.with_notice do %>
          <%= render layout: 'certificates/assessment_info' do %>
            <p class="govuk-body">
              You've taken the test once without passing. You can take it again straight away. If you don't pass, you'll need to wait 48 hours before trying again.
            </p>
          <% end %>
        <% end %>
      <% elsif user_programme_assessment.failed_num_attempts > 1 %>
        <% component.with_notice do %>
          <%= render layout: 'certificates/assessment_info' do %>
            <p class="govuk-body">
              You've taken the test <%= attempt_count_in_words(user_programme_assessment.failed_num_attempts) %> without passing. If you don't pass your next attempt, you'll need to wait 48 hours before trying again.
            </p>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
