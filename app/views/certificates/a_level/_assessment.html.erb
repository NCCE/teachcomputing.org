<div class="govuk-body ncce-csa-dash__section ncce-csa-dash__section-padded" id="a-level-test">
  <%= render 'certificates/assessment_attempt_status', attempt: @latest_attempt %>
  <% unless @latest_attempt&.in_state?(:commenced) %>
    <%= render AssessmentDetailsComponent.new(
      user: current_user,
      assessment: @assessment,
      duration: 60,
      question_count: 40,
      extended_duration: 90,
      conditions_url: a_level_test_conditions_url
    ) %>
  <% end %>
</div>
